# Copy to .env.production and fill in. Never commit the real file.
DOMAIN=hrms.example.com
DB_USER=hrms
# Letters and digits only (it goes into a connection URL). Generate one with: openssl rand -hex 24
DB_PASSWORD=generate-with-openssl-rand-hex-24
DB_NAME=hrms
# Caddy (automatic HTTPS) is off by default. Uncomment ONLY if nothing else on the server uses ports 80/443:
# COMPOSE_PROFILES=caddy
# Local port the app listens on for your reverse proxy (nginx). Change it if 3300 is taken:
# APP_PORT=3300
SESSION_TTL_HOURS=8
# Optional, for video/voice calls across networks (baked in at build):
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478
# NEXT_PUBLIC_TURN_USER=
# NEXT_PUBLIC_TURN_PASS=
